# llama.cpp server configuration
# Place your GGUF model files in ~/ai/models/llm/ and set LLAMA_ARG_MODEL below
#
# Server binds 8080 inside the container; the quadlet publishes it as host
# port 8888 (see llamacpp.container). Other containers on the home network
# reach it as llamacpp:8080; from the host use localhost:8888.

# LLAMA_ARG_MODEL=/models/qwen2.5-7b-instruct-q4_k_m.gguf
# LLAMA_ARG_CTX_SIZE=16384
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_GPU_LAYERS=auto
LLAMA_ARG_PORT=8080
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_MODELS_DIR=/models
