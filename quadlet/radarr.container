# Podman Quadlet file for Radarr (movie manager)
#
# Install as a rootless user service:
#   mkdir -p ~/.config/containers/systemd
#   cp radarr.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start radarr.service
#   systemctl --user enable radarr.service   # start on login
#
# Web UI: http://localhost:7878
# Shares /data with qbittorrent (same paths on both sides, so no remote
# path mapping is needed): downloads land in /data/downloads/movies, library
# root folder is /data/media/movies. Config lives in ~/.config/radarr.

[Unit]
Description=Radarr Movie Manager
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver/radarr
ContainerName=radarr

# Shared media stack network — reach peers by name (qbittorrent:8080, etc.)
Network=media.network

# Web UI
PublishPort=7878:7878

Volume=/data:/data:z
Volume=%h/.config/radarr:/config:Z

# PUID/PGID of the host user so media files are owned by you
Environment=PUID=1000
Environment=PGID=1000
# Keep the host user's UID inside the user namespace
UserNS=keep-id
# Uncomment to set your timezone (affects log timestamps):
# Environment=TZ=America/Los_Angeles

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
